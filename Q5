#include <iostream>
#include <queue>
using namespace std;

class Stack {
    queue<int> primary, secondary;

public:
    void push(int x) {
        secondary.push(x);
        while (!primary.empty()) {
            secondary.push(primary.front());
            primary.pop();
        }
        swap(primary, secondary);
    }

    void pop() {
        if (primary.empty()) {
            cout << "stack empty" << endl;
            return;
        }
        primary.pop();
    }

    int top() {
        if (primary.empty()) return -1;
        return primary.front();
    }

    bool empty() {
        return primary.empty();
    }
};

int main() {
    Stack st;
    st.push(10);
    st.push(20);
    st.push(30);

    cout << "top: " << st.top() << endl;
    st.pop();
    cout << "top after pop: " << st.top() << endl;
    return 0;
}
