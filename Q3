#include <iostream>
#include <queue>
using namespace std;

void rearrange(queue<int>& q) {
    int n = q.size();
    int half = n / 2;
    queue<int> temp;

    for (int i = 0; i < half; i++) {
        temp.push(q.front());
        q.pop();
    }

    while (!temp.empty()) {
        q.push(temp.front());
        temp.pop();

        q.push(q.front());
        q.pop();
    }
}

int main() {
    queue<int> q;
    int count, value;
    cout << "enter number of elements: ";
    cin >> count;

    cout << "enter elements: ";
    for (int i = 0; i < count; i++) {
        cin >> value;
        q.push(value);
    }

    rearrange(q);

    cout << "interleaved queue: ";
    while (!q.empty()) {
        cout << q.front() << " ";
        q.pop();
    }
    return 0;
}
